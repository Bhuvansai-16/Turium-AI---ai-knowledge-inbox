# Copy to backend/.env. Optional: you can also pick a provider and paste a key in the app's
# Settings page instead. Fill in ONE provider block; only these values change between them.

# --- OpenAI (default) ----------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1/
CHAT_MODEL=gpt-6-luna
EMBED_MODEL=text-embedding-3-small
EMBED_QUERY_INSTRUCTION=
MIN_SCORE=0.3

# --- Google Gemini (native LangChain integration) ------------------------------
# LLM_API_KEY=your-gemini-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/
# CHAT_MODEL=gemini-3.5-flash-lite
# EMBED_MODEL=gemini-embedding-001
# EMBED_QUERY_INSTRUCTION=
# MIN_SCORE=0.45

# --- Any OpenAI-compatible server: two examples --------------------------------
# Ollama (free, fully local). First run: ollama pull llama3.1 && ollama pull nomic-embed-text
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1/
# CHAT_MODEL=llama3.1
# EMBED_MODEL=nomic-embed-text
# EMBED_QUERY_INSTRUCTION=
# MIN_SCORE=0.4
#
# Nebius Token Factory. Qwen3-Embedding is instruction-tuned: questions get this task
# description, saved documents don't.
# LLM_API_KEY=your-nebius-key
# LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# CHAT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# EMBED_QUERY_INSTRUCTION=Given a question, retrieve passages from saved notes and web pages that answer it
# MIN_SCORE=0.45

# --- App -------------------------------------------------------------------------
# MIN_SCORE: cosine similarity below which a passage counts as unrelated. It depends on the
# embedding model; the Nebius value was calibrated, the others are tested starting points.
DB_PATH=data/inbox.db
LOG_LEVEL=INFO
